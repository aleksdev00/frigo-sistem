APP_NAME="Frigo Sistem"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Belgrade
APP_KEY=
SESSION_IDLE_TIMEOUT=1800

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=frigo_sistem
DB_USERNAME=frigo_sistem
DB_PASSWORD=

# Use "log" locally. Production must use "smtp" with real Hostinger mailbox values.
MAIL_TRANSPORT=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Frigo Sistem"
CONTACT_TO_ADDRESS=
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=3600
CONTACT_MIN_FILL_SECONDS=3
