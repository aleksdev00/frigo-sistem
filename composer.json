{
    "name": "frigo-sistem/website",
    "description": "Lightweight PHP foundation for the Frigo Sistem website.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "db:migrate": [
            "@php database/migrate.php"
        ],
        "db:check": [
            "@php tests/database.php"
        ],
        "admin:create": [
            "@php database/admin.php create"
        ],
        "check": [
            "@php tests/run.php",
            "@php tests/auth.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
